{
  "name": "trade-journal-recorder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Trading journal with the session recorded underneath it.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "app": "electron .",
    "start": "electron .",
    "dist:win": "node scripts/check-build-config.mjs && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-builder --dir",
    "check:build": "node scripts/check-build-config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.4.2",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "6.2.5",
    "vitest": "5.0.0"
  },
  "main": "electron/main.js",
  "productName": "Trade Journal Recorder",
  "build": {
    "appId": "com.tradejournal.recorder",
    "productName": "Trade Journal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "src/**/*",
      "electron/**/*",
      "build/icon.png",
      "!**/*.map",
      "!**/*.md",
      "!**/test/**",
      "!**/tests/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "TradeJournal-Setup-${version}.${ext}",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "TradeJournal-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "copyright": "Copyright © 2026 Ziv Nahum",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trade Journal",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "TradeJournal-Setup-${version}.${ext}",
      "uninstallDisplayName": "Trade Journal"
    },
    "compression": "maximum",
    "removePackageScripts": true,
    "removePackageKeywords": true,
    "asar": true,
    "electronLanguages": [
      "en-US"
    ]
  },
  "author": {
    "name": "Ziv Nahum"
  }
}
